{
  "schema_version": 1,
  "name": "hole-a-default-straight-search",
  "description": "仅覆盖需要按工件/孔位调整的值；未出现的参数沿用 place_hole_a_wiggle.py 的安全默认值。",
  "parameters": {
    "planner_config": "../../config.hole_a_first_live_fast_return.json",
    "initial_motion": "planner-movej",
    "initial_right_joints_deg": [22.43, 23.33, 0.52, 66.99, -62.2, -64.44, 25.51],
    "arm_host": "192.168.88.1",
    "force_host": "127.0.0.1",
    "straight_line": true,
    "continuous_straight_search": true,
    "back_step_mm": 1.0,
    "max_back_mm": 40.0,
    "fast_linear_speed_mm_s": 7.0,
    "fast_linear_accel_mm_s2": 20.0,
    "slow_after_back_mm": 15.0,
    "slow_linear_speed_mm_s": 7.0,
    "slow_linear_accel_mm_s2": 20.0,
    "baseline_samples": 20,
    "max_force_delta_n": 20.0,
    "max_torque_delta_nm": 5.0,
    "min_entry_back_mm": 8.0,
    "output": "logs/hole_a_default.log"
  }
}
