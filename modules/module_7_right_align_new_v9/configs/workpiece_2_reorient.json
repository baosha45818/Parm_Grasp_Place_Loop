{
  "schema": "reorient-workpiece-config/v2",
  "workpiece": "workpiece_2",
  "description": "工件2调整：旧的语义 -X 25 mm 与 body_base +Z 10 mm 合并迁移为工件坐标偏移 [-25, 0, +10] mm。预抓取点沿工件 +Z 70 mm，最终点不额外下探；TCP +X=-工件 Z、+Y=±工件 Y、+Z=±工件 X。XYZ 预抓取容差为 0，RPY 容差为 15/15/15 度。",
  "semantic_grasp_rule": {
    "formula": "P_grasp = TransformPoint(T_body_base_workpiece_semantic, grasp_point_semantic_offset_m)",
    "pregrasp": "P_pregrasp = P_grasp + pregrasp_positive_workpiece_z_m * workpiece_Z",
    "final": "P_final = P_grasp - final_extra_descent_negative_workpiece_z_m * workpiece_Z",
    "tcp_axes": "TCP +X = workpiece -Z; TCP +Y = workpiece +/-Y; TCP +Z = workpiece +/-X"
  },
  "reorient_arguments": {
    "--grasp-point-semantic-offset-m": [-0.035, 0.000, 0.00],
    "--pregrasp-positive-workpiece-z-m": 0.07,
    "--final-extra-descent-negative-workpiece-z-m": -0.004,
    "--pregrasp-position-tolerance-m": [0.0, 0.0, 0.0],
    "--pregrasp-rpy-tolerance-deg": [6.0, 6.0, 6.0],
    "--tcp-x-negative-workpiece-z-tolerance-deg": 6.0,
    "--tcp-y-parallel-workpiece-y-tolerance-deg": 10.0,
    "--tcp-z-parallel-workpiece-x-tolerance-deg": 6.0,
    "--servo-linear-speed-mps": 0.05,
    "--servo-angular-speed-radps": 0.3,
    "--servo-max-linear-accel-mps2": 0.1,
    "--servo-max-angular-accel-radps2": 0.6,
    "--servo-hz": 50.0,
    "--servo-position-tolerance-m": 0.0005,
    "--servo-orientation-tolerance-rad": 0.035,
    "--servo-settle-timeout-s": 8.0,
    "--place-tcp-extra-clearance-m": 0.02,
    "--lift-height-m": [0.12, 0.10, 0.08],
    "--post-release-lift-height-m": 0.02,
    "--attitude-search-step-deg": 2.0,
    "--planning-timeout-s": 5.0,
    "--q1-yaw-min-deg": 15.0,
    "--q1-yaw-max-deg": 75.0,
    "--q1-yaw-search-step-deg": 5.0,
    "--q1-preferred-yaw-deg": 35.0,
    "--turn-roll-tolerance-deg": 30.0,
    "--turn-pitch-tolerance-deg": 30.0,
    "--turn-attitude-search-step-deg": 15.0,
    "--turn-relocation-step-m": 0.04,
    "--post-grasp-turn-search-negative-base-x-m": 0.03,
    "--post-grasp-turn-search-negative-base-y-m": 0.2,
    "--turn-station-tcp-height-m": 0.12,
    "--turn-search-grid-step-m": 0.05,
    "--place-negative-xy-min-m": 0.0,
    "--place-negative-xy-max-m": 0.05,
    "--place-positive-x-max-m": 0.05,
    "--turn-positive-x-min-m": 0.0,
    "--turn-positive-x-max-m": 0.2,
    "--place-negative-y-max-m": 0.15,
    "--place-region-grid-step-m": 0.05,
    "--place-search-grid-step-m": 0.025,
    "--rrt-place-parallelism": 3,
    "--rrt-turn-parallelism": 3,
    "--placement-visibility-roi": [0.08, 0.20, 0.98, 0.90],
    "--placement-visibility-margin-px": 30.0,
    "--planner": "rrtstar",
    "--turn-planner": "rrtconnect",
    "--max-vel": 0.08,
    "--max-acc": 0.08,
    "--trajectory-execution-speed-scale": 2.0,
    "--start-sync-retries": 3,
    "--gripper-timeout-s": 5.0,
    "--gripper-position-tolerance": 5.0,
    "--grasp-minimum-close-travel": 5.0,
    "--grasp-contact-settle-s": 0.5
  }
}
