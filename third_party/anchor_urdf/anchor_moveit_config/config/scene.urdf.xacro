<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scene">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import scene urdf file -->
    <xacro:include filename="$(find anchor_config)/description/urdf/scene.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="scene.ros2_control.xacro" />


    <xacro:scene_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
