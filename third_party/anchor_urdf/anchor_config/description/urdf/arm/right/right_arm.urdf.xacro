<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="右臂" params="prefix parent *origin">
        <link name="${prefix}base">
            <inertial>
                <origin xyz="0.13926 1.0779 2.255E-05" rpy="0 0 0"/>
                <mass value="0.11116"/>
                <inertia ixx="0.00018114" ixy="5.2731E-06" ixz="-8.6876E-08" iyy="0.00015662" iyz="-4.0992E-08" izz="0.00015531"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/arm/right/base.STL"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/arm/right/base.STL"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint_base" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="${prefix}base" />
        </joint>
        <link name="${prefix}link1">
