                <mass value="0.12519"/>
                <inertia ixx="0.00035375" ixy="4.6286E-08" ixz="5.0932E-08" iyy="0.00036163" iyz="-5.0183E-06" izz="9.6543E-05"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
