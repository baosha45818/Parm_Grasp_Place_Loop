<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="头部" params="prefix parent *origin">
        <link name="${prefix}base"/>
        <joint name="${prefix}joint_base" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="${prefix}base" />
        </joint>
        <link name="${prefix}link1">
            <inertial>
                <origin xyz="-0.00011922 0.003701 0.030481" rpy="0 0 0"/>
                <mass value="0.21352"/>
                <inertia ixx="0.00013678" ixy="9.0011E-07" ixz="2.9246E-07" iyy="0.00010572" iyz="-6.741E-06" izz="0.00010754"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/head/link1.STL"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/head/link1.STL"/>
                </geometry>
            </collision>
        </link>
        <link name="${prefix}link2">
            <inertial>
                <origin xyz="0.0078291 0.039344 0.11375" rpy="0 0 0"/>
                <mass value="1.0836"/>
                <inertia ixx="0.0074258" ixy="2.8842E-06" ixz="0.00052893" iyy="0.0035548" iyz="-2.4554E-05" izz="0.0064"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/head/link2.STL"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/head/link2.STL"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint_link1" type="revolute">
            <origin xyz="0 0 0.039718" rpy="0 0 0"/>
            <parent link="${prefix}base"/>
            <child link="${prefix}link1"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.047" upper="1.047" effort="5" velocity="5"/>
        </joint>
        <joint name="${prefix}joint_link2" type="revolute">
            <origin xyz="0.00081107 -0.041492 0.07" rpy="0 0 0.019545"/>
            <parent link="${prefix}link1"/>
            <child link="${prefix}link2"/>
            <axis xyz="0 1 0"/>
            <limit lower="-0.785" upper="0.785" effort="5" velocity="5"/>
        </joint>
    </xacro:macro>
</robot>