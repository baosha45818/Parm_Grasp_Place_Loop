<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="转接件" params="prefix parent *origin">
        <link name="${prefix}base">
            <inertial>
                <origin xyz="0.30087 0.88881 0.44433" rpy="0 0 0"/>
                <mass value="0.17064"/>
                <inertia ixx="6.383E-05" ixy="2.1967E-06" ixz="1.5193E-06" iyy="5.3855E-05" iyz="-7.1859E-06" izz="9.9423E-05"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/transfer/base.STL"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/transfer/base.STL"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint_base" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="${prefix}base" />
        </joint>
        <link name="${prefix}end">
            <inertial>
                <origin xyz="1.8812E-07 0.00019223 0.0033257" rpy="0 0 0"/>
                <mass value="0.02433"/>
                <inertia ixx="5.1689E-06" ixy="1.0796E-11" ixz="-2.5043E-12" iyy="1.5531E-05" iyz="-3.384E-09" izz="2.0296E-05"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/transfer/end.STL"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/transfer/end.STL"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint_end" type="fixed">
            <origin xyz="0.30727 -0.4445 0.85926" rpy="-1.5708 0.20944 -3.1416"/>
            <parent link="${prefix}base"/>
            <child link="${prefix}end"/>
            <axis xyz="0 0 0"/>
        </joint>
    </xacro:macro>
</robot>