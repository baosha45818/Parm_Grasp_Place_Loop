<?xml version="1.0" encoding="utf-8"?>
<!--
    左手大寰 AG95 夹爪(mimic 关节驱动版)
    - 主动关节: ${prefix}gripper_finger1_joint(单个 revolute)
    - 其余 5 个 finger 关节(gripper_finger2 / finger1_inner_knuckle / finger2_inner_knuckle
      / finger1_finger / finger2_finger / finger1_finger_tip / finger2_finger_tip)用 mimic 跟随 finger1
    - mesh 走 anchor_config/meshes/hand_tool/left/
    - 由于 MuJoCo 不需要 gazebo mimic plugin,所以这里只用 <mimic> 标签(URDF 原生)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="左手" params="prefix parent *origin">
        <link name="${prefix}transfer_base">
            <inertial>
                <origin xyz="0.30087 0.88881 0.44433" rpy="0 0 0"/>
                <mass value="0.17064"/>
                <inertia ixx="6.383E-05" ixy="2.1967E-06" ixz="1.5193E-06" iyy="5.3855E-05" iyz="-7.1859E-06" izz="9.9423E-05"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/transfer/base.STL"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/transfer/base.STL"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint_transfer_base" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="${prefix}transfer_base" />
        </joint>
        <link name="${prefix}transfer_end"/>
        <joint name="${prefix}joint_transfer_end" type="fixed">
            <origin xyz="0.0495 0 0.0002853" rpy="-1.5708 0 -1.5708"/>
            <parent link="${prefix}transfer_base"/>
            <child link="${prefix}transfer_end"/>
            <axis xyz="0 0 0"/>
        </joint>
        
        <!-- 夹爪底部,挂到转接件末端(${prefix}end) -->
        <joint name="${prefix}gripper_base_joint" type="fixed">
            <parent link="${prefix}transfer_end"/>
            <child link="${prefix}gripper_base_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

        <link name="${prefix}gripper_base_link">
            <visual>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/base_link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/base_link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.83416"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="0.0013016" ixy="-6.9374e-07" ixz="5.9848e-07"
                         iyy="0.00049972" iyz="2.0244e-07" izz="0.001498"/>
            </inertial>
        </link>

        <!-- ========== 主动关节: gripper_finger1_joint(revolute,可驱动) ========== -->
        <joint name="${prefix}gripper_finger1_joint" type="revolute">
            <parent link="${prefix}gripper_base_link"/>
            <child link="${prefix}gripper_finger1_knuckle_link"/>
            <axis xyz="0 -1 0"/>
            <origin rpy="0 0 ${pi}" xyz="-0.016 0 0.10586"/>
            <limit lower="0.0" upper="0.65" velocity="2.0" effort="1000"/>
        </joint>

        <link name="${prefix}gripper_finger1_knuckle_link">
            <visual>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/crank_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/crank_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.011111"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="3.88172e-06" ixy="-2.29456e-13" ixz="8.33e-07"
                         iyy="1.92174e-06" iyz="2.04435e-13" izz="4.32374e-06"/>
            </inertial>
        </link>

        <!-- ========== mimic: gripper_finger2_joint(对侧,镜像行为) ========== -->
        <joint name="${prefix}gripper_finger2_joint" type="revolute">
            <parent link="${prefix}gripper_base_link"/>
            <child link="${prefix}gripper_finger2_knuckle_link"/>
            <axis xyz="0 -1 0"/>
            <origin rpy="0 0 0" xyz="0.016 0 0.10586"/>
            <limit lower="-3.14" upper="3.14" velocity="100.0" effort="1000"/>
            <mimic joint="${prefix}gripper_finger1_joint" multiplier="1.0" offset="0"/>
        </joint>

        <link name="${prefix}gripper_finger2_knuckle_link">
            <visual>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/crank_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/crank_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.011111"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="3.88172e-06" ixy="-2.29456e-13" ixz="8.33e-07"
                         iyy="1.92174e-06" iyz="2.04435e-13" izz="4.32374e-06"/>
            </inertial>
        </link>

        <!-- ========== mimic: finger1 inner_knuckle ========== -->
        <joint name="${prefix}gripper_finger1_inner_knuckle_joint" type="continuous">
            <parent link="${prefix}gripper_base_link"/>
            <child link="${prefix}gripper_finger1_inner_knuckle_link"/>
            <axis xyz="0 -1 0"/>
            <origin rpy="0 0 ${pi}" xyz="-0.016 0 0.10586"/>
            <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
            <mimic joint="${prefix}gripper_finger1_joint" multiplier="1.49462955" offset="0"/>
        </joint>

        <link name="${prefix}gripper_finger1_inner_knuckle_link">
            <visual>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/proximal_phalanx_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/proximal_phalanx_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.0318004"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="1.39848e-05" ixy="-9.54763e-15" ixz="-5.01422e-06"
                         iyy="1.04943e-05" iyz="8.94585e-16" izz="1.36183e-05"/>
            </inertial>
        </link>

        <!-- ========== mimic: finger2 inner_knuckle ========== -->
        <joint name="${prefix}gripper_finger2_inner_knuckle_joint" type="continuous">
            <parent link="${prefix}gripper_base_link"/>
            <child link="${prefix}gripper_finger2_inner_knuckle_link"/>
            <axis xyz="0 -1 0"/>
            <origin rpy="0 0 0" xyz="0.016 0 0.10586"/>
            <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
            <mimic joint="${prefix}gripper_finger1_joint" multiplier="1.49462955" offset="0"/>
        </joint>

        <link name="${prefix}gripper_finger2_inner_knuckle_link">
            <visual>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/proximal_phalanx_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/proximal_phalanx_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.0318004"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="1.39848e-05" ixy="-9.54763e-15" ixz="-5.01422e-06"
                         iyy="1.04943e-05" iyz="8.94585e-16" izz="1.36183e-05"/>
            </inertial>
        </link>

        <!-- ========== mimic: finger1 finger(从 finger1_knuckle 伸出) ========== -->
        <joint name="${prefix}gripper_finger1_finger_joint" type="continuous">
            <parent link="${prefix}gripper_finger1_knuckle_link"/>
            <child link="${prefix}gripper_finger1_finger_link"/>
            <axis xyz="0 -1 0"/>
            <origin xyz="0.0292080077784 0.0 -0.0227132622407" rpy="0 0 0"/>
            <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
            <mimic joint="${prefix}gripper_finger1_joint" multiplier="0.4563942" offset="0"/>
        </joint>

        <link name="${prefix}gripper_finger1_finger_link">
            <visual>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/rod_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/rod_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.0222871"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="8.72836e-06" ixy="7.0843e-15" ixz="-2.18833e-06"
                         iyy="7.26157e-06" iyz="7.6579e-15" izz="3.3425e-06"/>
            </inertial>
        </link>

        <!-- ========== mimic: finger2 finger(从 finger2_knuckle 伸出) ========== -->
        <joint name="${prefix}gripper_finger2_finger_joint" type="continuous">
            <parent link="${prefix}gripper_finger2_knuckle_link"/>
            <child link="${prefix}gripper_finger2_finger_link"/>
            <axis xyz="0 -1 0"/>
            <origin xyz="0.0292080077784 0.0 -0.0227132622407" rpy="0 0 0"/>
            <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
            <mimic joint="${prefix}gripper_finger1_joint" multiplier="0.4563942" offset="0"/>
        </joint>

        <link name="${prefix}gripper_finger2_finger_link">
            <visual>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/rod_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/rod_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.0222871"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="8.72836e-06" ixy="7.0843e-15" ixz="-2.18833e-06"
                         iyy="7.26157e-06" iyz="7.6579e-15" izz="3.3425e-06"/>
            </inertial>
        </link>

        <!-- ========== mimic: finger1 tip(从 finger1_inner_knuckle 伸出,绕 Y 反向) ========== -->
        <joint name="${prefix}gripper_finger1_finger_tip_joint" type="continuous">
            <parent link="${prefix}gripper_finger1_inner_knuckle_link"/>
            <child link="${prefix}gripper_finger1_finger_tip_link"/>
            <axis xyz="0 1 0"/>
            <origin xyz="0.0394969463769 0.0 0.0382752038125" rpy="0 0 0"/>
            <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
            <mimic joint="${prefix}gripper_finger1_joint" multiplier="1.49462955"/>
        </joint>

        <link name="${prefix}gripper_finger1_finger_tip_link">
            <visual>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/distal_phalanx_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/distal_phalanx_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.0124305"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="2.84217e-06" ixy="-2.48048e-15" ixz="8.24539e-07"
                         iyy="3.03961e-06" iyz="2.16427e-13" izz="1.11815e-06"/>
            </inertial>
        </link>

        <!-- ========== mimic: finger2 tip(从 finger2_inner_knuckle 伸出) ========== -->
        <joint name="${prefix}gripper_finger2_finger_tip_joint" type="continuous">
            <parent link="${prefix}gripper_finger2_inner_knuckle_link"/>
            <child link="${prefix}gripper_finger2_finger_tip_link"/>
            <axis xyz="0 1 0"/>
            <origin xyz="0.0394969463769 0.0 0.0382752038125" rpy="0 0 0"/>
            <limit lower="-3.14" upper="3.14" velocity="100.0" effort="0.1"/>
            <mimic joint="${prefix}gripper_finger1_joint" multiplier="1.49462955"/>
        </joint>

        <link name="${prefix}gripper_finger2_finger_tip_link">
            <visual>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/distal_phalanx_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/left/distal_phalanx_Link.STL" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.0124305"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="2.84217e-06" ixy="-2.48048e-15" ixz="8.24539e-07"
                         iyy="3.03961e-06" iyz="2.16427e-13" izz="1.11815e-06"/>
            </inertial>
        </link>
    </xacro:macro>
</robot>
