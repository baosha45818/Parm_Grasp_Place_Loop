<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="右手" params="prefix parent *origin">
        <link name="${prefix}transfer_base">
            <inertial>
                <origin xyz="0.30087 0.88881 0.44433" rpy="0 0 0"/>
                <mass value="0.17064"/>
                <inertia ixx="6.383E-05" ixy="2.1967E-06" ixz="1.5193E-06" iyy="5.3855E-05" iyz="-7.1859E-06" izz="9.9423E-05"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/transfer/base.STL"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/transfer/base.STL"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint_transfer_base" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="${prefix}transfer_base" />
        </joint>
        <link name="${prefix}transfer_end"/>
        <joint name="${prefix}joint_transfer_end" type="fixed">
            <origin xyz="0.0495 0 0.0002853" rpy="-1.5708 0 -1.5708"/>
            <parent link="${prefix}transfer_base"/>
            <child link="${prefix}transfer_end"/>
            <axis xyz="0 0 0"/>
        </joint>
        <link name="${prefix}base">
            <inertial>
                <origin xyz="-0.00050002 -0.00027597 0.044636" rpy="0 0 0"/>
                <mass value="0.33719"/>
                <inertia ixx="0.00020772" ixy="-1.9134E-08" ixz="3.7458E-07" iyy="0.00022954" iyz="8.1314E-09" izz="0.00019523"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/right/base.STL"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/right/base.STL"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint_base" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${prefix}transfer_end" />
            <child link="${prefix}base" />
        </joint>
        <link name="${prefix}link1">
            <inertial>
                <origin xyz="0.04226 -0.011262 -0.021643" rpy="0 0 0"/>
                <mass value="0.060765"/>
                <inertia ixx="1.824E-05" ixy="8.9205E-06" ixz="2.6262E-05" iyy="8.9673E-05" iyz="-4.1123E-06" izz="8.3501E-05"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/right/link1.STL"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/right/link1.STL"/>
                </geometry>
            </collision>
        </link>
        <link name="${prefix}link2">
            <inertial>
                <origin xyz="0.036571 0.013582 -0.034649" rpy="0 0 0"/>
                <mass value="0.065914"/>
                <inertia ixx="4.3084E-05" ixy="-8.1197E-06" ixz="4.5501E-05" iyy="0.00012048" iyz="7.0292E-06" izz="8.9717E-05"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/right/link2.STL"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/right/link2.STL"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint_link1" type="prismatic">
            <origin xyz="0.018687 0.011465 0.1089" rpy="1.5708 -1.5708 0"/>
            <parent link="${prefix}base"/>
            <child link="${prefix}link1"/>
            <axis xyz="0 1 0"/>
            <limit lower="0" upper="0.025445" effort="5" velocity="5"/>
        </joint>
        <joint name="${prefix}joint_link2" type="prismatic">
            <mimic joint="${prefix}joint_link1"/>
            <origin xyz="-0.0182 -0.012035 0.1089" rpy="1.5708 -1.5708 0"/>
            <parent link="${prefix}base"/>
            <child link="${prefix}link2"/>
            <axis xyz="0 -1 0"/>
            <limit lower="-0.025445" upper="0" effort="5" velocity="5"/>
        </joint>
    </xacro:macro>
</robot>
