<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="夹爪" params="prefix parent *origin">
        <link name="${prefix}base">
            <inertial>
                <origin xyz="0.08038 0.0075152 -0.007724" rpy="0 0 0"/>
                <mass value="1.2661"/>
                <inertia ixx="0.0011728" ixy="8.8177E-07" ixz="7.3622E-05" iyy="0.00070096" iyz="1.7144E-06" izz="0.0010463"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/base.STL"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://anchor_config/description/meshes/hand_tool/base.STL"/>
                </geometry>
            </collision>
        </link>
        <joint name="${prefix}joint_base" type="fixed">
            <xacro:insert_block name="origin" />
            <parent link="${parent}" />
            <child link="${prefix}base" />
        </joint>
        <link name="${prefix}end_link"/>
        <joint
            name="${prefix}joint_end"
            type="fixed">
            <origin xyz="0.2635 0 -0.0995" rpy="0 0 0" />
            <parent link="${prefix}base" />
            <child link="${prefix}end_link" />
            <axis xyz="0 0 0" />
        </joint>
        <link name="${prefix}magnet"/>
        <joint
            name="${prefix}joint_magnet"
            type="fixed">
            <origin xyz="0.01 0.139 0" rpy="1.579079 0 0" />
            <parent link="${prefix}base" />
            <child link="${prefix}magnet" />
            <axis xyz="0 0 0" />
        </joint>
        <link name="${prefix}cam"/>
        <joint
            name="${prefix}joint_cam"
            type="fixed">
            <origin xyz="0.0855 0 -0.06543" rpy="0 1.579079 0" />
            <parent link="${prefix}base" />
            <child link="${prefix}cam" />
            <axis xyz="0 0 0" />
        </joint>
    </xacro:macro>
</robot>